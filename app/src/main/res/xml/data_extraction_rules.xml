<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- allowBackup=false 已禁用全部备份，此处保持全 exclude 避免规则冲突 -->
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
